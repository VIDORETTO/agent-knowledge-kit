{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS page derivative",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "created_at", "content_hash", "revision_id", "project_id", "page_id", "goal", "tone", "audience", "sections", "offer", "restrictions", "status", "pending_reasons"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"const": "page", "type": "string"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "page_id": {"type": "string", "minLength": 1},
    "goal": {"type": ["string", "null"]},
    "tone": {"type": ["string", "null"]},
    "audience": {"type": ["string", "null"]},
    "sections": {"type": "array", "items": {"type": "object"}},
    "offer": {"type": "object"},
    "restrictions": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["pending", "draft", "valid", "invalid"], "type": "string"},
    "pending_reasons": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object"}
  }
}
