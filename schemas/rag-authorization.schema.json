{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS RAG authorization",
  "type": "object",
  "required": [
    "schema_version",
    "authorization_id",
    "package_id",
    "action",
    "target_revision",
    "policy_revision",
    "actor",
    "authorized_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authorization_id": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "action": {"const": "index_rag"},
    "target_revision": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "minLength": 1},
    "actor": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "authorized_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": ["string", "null"]},
    "scope": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
