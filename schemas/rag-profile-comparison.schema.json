{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/rag-profile-comparison.schema.json",
  "title": "docops RAG embedding profile comparison",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "language",
    "current_profile",
    "profiles",
    "selected_profile",
    "requires_full_rebuild",
    "publication_allowed",
    "evidence_status",
    "required_evaluation",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"const": true},
    "language": {"type": "string"},
    "current_profile": {"type": "string", "minLength": 1},
    "current_configuration": {"type": "object"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "is_current",
          "comparison_status",
          "evaluation_required",
          "rebuild_required"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "is_current": {"type": "boolean"},
          "comparison_status": {"const": "not_evaluated"},
          "evaluation_required": {"const": true},
          "rebuild_required": {"type": "boolean"}
        }
      }
    },
    "selected_profile": {"type": "string", "minLength": 1},
    "requires_full_rebuild": {"type": "boolean"},
    "publication_allowed": {"const": false},
    "evidence_status": {"const": "not_evaluated"},
    "required_evaluation": {"const": "reviewed_golden_native_portuguese"},
    "decision": {"enum": ["full_rebuild_required", "no_profile_change"]}
  }
}
