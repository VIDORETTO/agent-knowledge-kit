{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS project backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "created_at", "content_hash", "backup_id", "project_id", "created_at_source", "root_locator", "files", "excluded", "rpo_observed_at"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"const": "backup_manifest", "type": "string"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backup_id": {"type": "string", "minLength": 1},
    "project_id": {"type": ["string", "null"]},
    "created_at_source": {"type": "string", "minLength": 20},
    "root_locator": {"const": "folder", "type": "string"},
    "files": {"type": "array", "items": {"type": "object"}},
    "excluded": {"type": "array", "items": {"type": "string"}},
    "rpo_observed_at": {"type": "string", "minLength": 20},
    "extensions": {"type": "object"}
  }
}
