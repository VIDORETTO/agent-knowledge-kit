{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/feedback-report.schema.json",
  "title": "docops public usage feedback report",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "report_id",
    "package_id",
    "window",
    "counts",
    "usage",
    "comparison",
    "occurrences",
    "investigations",
    "publication_allowed",
    "golden_changed",
    "expected_response_changed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"type": "boolean"},
    "report_id": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "window": {
      "type": "object",
      "required": ["start", "end", "days"],
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "days": {"type": "integer"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["submissions", "unique_occurrences", "duplicate_submissions", "investigations"],
      "properties": {
        "submissions": {"type": "integer"},
        "unique_occurrences": {"type": "integer"},
        "duplicate_submissions": {"type": "integer"},
        "investigations": {"type": "integer"}
      }
    },
    "usage": {
      "type": "object",
      "required": ["latency_ms", "cost_units", "denominators"],
      "properties": {
        "latency_ms": {"type": "object"},
        "cost_units": {"type": "object"},
        "denominators": {"type": "object"}
      }
    },
    "comparison": {"type": "object"},
    "occurrences": {"type": "array"},
    "investigations": {"type": "array"},
    "publication_allowed": {"const": false},
    "golden_changed": {"const": false},
    "expected_response_changed": {"const": false}
  }
}
