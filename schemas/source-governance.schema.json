{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS source governance overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "created_at", "content_hash", "sources", "policy_revision", "updated_at"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"const": "source_governance_registry", "type": "string"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "policy_revision": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 20},
    "extensions": {"type": "object"}
  }
}
