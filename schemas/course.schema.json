{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS course derivative",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "created_at", "content_hash", "revision_id", "project_id", "course_id", "intent", "level", "transformation", "format", "modules", "status", "pending_reasons"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"const": "course", "type": "string"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "course_id": {"type": "string", "minLength": 1},
    "intent": {"type": ["string", "null"]},
    "level": {"type": ["string", "null"]},
    "transformation": {"type": ["string", "null"]},
    "format": {"type": ["string", "null"]},
    "modules": {"type": "array", "items": {"type": "object"}},
    "status": {"enum": ["pending", "draft", "valid", "invalid"], "type": "string"},
    "pending_reasons": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "object"}
  }
}
