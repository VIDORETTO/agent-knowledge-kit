{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/evaluation-receipt.schema.json",
  "title": "docops external response evaluation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "generation_id",
    "candidate_id",
    "package_composition_hash",
    "golden_revision",
    "evaluator",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "package_composition_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "golden_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rubric_revision": {"type": "string", "minLength": 1},
    "evaluator": {
      "type": "object",
      "required": ["name", "version", "independent"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "independent": {"const": true}
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "claims"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "critical": {"type": "boolean"},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim_id", "supported"],
              "properties": {
                "claim_id": {"type": "string", "minLength": 1},
                "supported": {"type": "boolean"},
                "critical": {"type": "boolean"},
                "requires_citation": {"type": "boolean"},
                "citations": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
