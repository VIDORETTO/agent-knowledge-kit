{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS job effect receipt",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "package_id",
    "target_revision",
    "request_hash",
    "status",
    "effect_code",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "target_revision": {"type": "string", "minLength": 1},
    "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "succeeded"},
    "effect_code": {"type": "string", "minLength": 1},
    "result_ref": {"type": ["string", "null"]},
    "recorded_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
