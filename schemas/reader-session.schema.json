{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/reader-session.schema.json",
  "title": "docops pinned reader session",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "package_id",
    "generation",
    "snapshot",
    "created_at",
    "expires_at",
    "status",
    "permissions",
    "backend"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "required": ["release_id", "composition_hash"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "composition_hash": {"type": "string", "minLength": 1}
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "snapshot_id",
        "release_id",
        "composition_hash",
        "corpus_hash",
        "profile",
        "embedding_fingerprint",
        "model",
        "configuration_hash",
        "artifacts_hash",
        "revocation_hash"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "release_id": {"type": "string", "minLength": 1},
        "composition_hash": {"type": "string", "minLength": 1},
        "corpus_hash": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "embedding_fingerprint": {"type": "string", "minLength": 1},
        "model": {"type": "object"},
        "configuration_hash": {"type": "string", "minLength": 1},
        "artifacts_hash": {"type": "string", "minLength": 1},
        "revocation_hash": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "revoked", "expired"]},
    "permissions": {
      "type": "object",
      "required": ["profile", "read_only", "allowed_tools", "denied_tools"],
      "properties": {
        "profile": {"const": "reader"},
        "read_only": {"const": true},
        "allowed_tools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "denied_tools": {"type": "array", "items": {"type": "string"}}
      }
    },
    "backend": {
      "type": "object",
      "required": ["adapter", "concurrent_publication_allowed"],
      "properties": {
        "adapter": {"enum": ["memory", "mcp"]},
        "concurrent_publication_allowed": {"const": false},
        "capability_source": {"type": "string"}
      }
    }
  }
}
