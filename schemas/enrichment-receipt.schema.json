{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/enrichment-receipt.schema.json",
  "title": "docops external enrichment receipt",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "candidate_id",
    "base_release_id",
    "base_composition_hash",
    "candidate_composition_hash",
    "tool",
    "inputs",
    "outputs",
    "validation",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "base_release_id": {"type": "string", "minLength": 1},
    "base_composition_hash": {"type": "string", "minLength": 1},
    "candidate_composition_hash": {"type": "string", "minLength": 1},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 64}
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["ok"],
      "properties": {"ok": {"type": "boolean"}}
    },
    "provenance": {"type": "object"},
    "usage": {"type": "object"}
  }
}
