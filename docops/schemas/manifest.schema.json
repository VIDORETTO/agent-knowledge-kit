{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/manifest.schema.json",
  "title": "docops execution manifest",
  "type": "object",
  "required": ["schema_version", "contract_version", "run_id", "created_at", "status", "source", "provenance", "entries", "counts", "artifacts", "checkpoints", "metrics", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "partial", "blocked", "failed", "cancelled"]},
    "source": {"$ref": "#/$defs/source"},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "discovery": {"type": "object"},
    "provenance": {"type": "object", "required": ["license", "redistribution"]},
    "entries": {"type": "array", "items": {"type": "object"}},
    "counts": {"type": "object", "required": ["accepted", "ignored", "errors"]},
    "artifacts": {"type": "object", "required": ["skill", "router", "rag"]},
    "checkpoints": {"type": "object"},
    "metrics": {"type": "object"},
    "readiness": {"type": "object"},
    "outcome": {"type": "object", "required": ["status", "code", "phase", "message", "exit_code"], "properties": {"status": {"enum": ["succeeded", "blocked", "failed", "cancelled"]}, "code": {"type": "string", "minLength": 1}, "phase": {"type": "string", "minLength": 1}, "message": {"type": "string"}, "exit_code": {"type": "integer"}}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["input", "kind", "canonical"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "canonical": {"type": "string", "minLength": 1},
        "version": {},
        "slug": {},
        "scope": {},
        "official": {},
        "requires_decision": {"type": "boolean"}
      }
    }
  }
}
