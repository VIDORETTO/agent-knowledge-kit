{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS delegated factual authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "created_at", "content_hash", "authorization_id", "project_id", "owner", "actions", "source_ids", "expires_at", "budget", "authority_ref", "kill_switch", "status", "policy_revision"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"const": "delegated_authorization", "type": "string"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": "string", "minLength": 20},
    "budget": {"type": "object"},
    "authority_ref": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "minLength": 1},
    "kill_switch": {"type": "boolean"},
    "status": {"enum": ["active", "revoked", "expired", "exhausted"], "type": "string"},
    "revoked_at": {"type": "string", "minLength": 20},
    "reason": {"type": "string"},
    "extensions": {"type": "object"}
  }
}
