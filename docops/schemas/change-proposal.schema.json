{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS project change proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "created_at", "content_hash", "change_id", "project_id", "base_project_revision_id", "base_package_ref", "operations", "requested_by", "reason", "policy_revision", "dependency_graph", "status"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"const": "change_proposal", "type": "string"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "base_project_revision_id": {"type": "string", "minLength": 1},
    "base_package_ref": {"type": ["object", "null"]},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "requested_by": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "policy_revision": {"type": "string", "minLength": 1},
    "dependency_graph": {"type": "object"},
    "dependency_review_ack": {"type": "boolean"},
    "manual_reviewed": {"type": "boolean"},
    "status": {"enum": ["proposed", "prepared", "activation_pending", "activated", "failed", "cancelled"], "type": "string"},
    "extensions": {"type": "object"}
  }
}
