{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/publication.schema.json",
  "title": "docops publication receipt",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "candidate_id",
    "approval_id",
    "composition_hash",
    "parent_release_id",
    "published_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "composition_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_release_id": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "minLength": 1}
  }
}
