{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCOPS evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "created_at", "content_hash", "claim_id", "project_id", "text", "classification", "region", "validity", "evidence_refs", "conflict_ids", "review_status", "reviewer_ref"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "kind": {"const": "claim", "type": "string"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_id": {"type": "string", "minLength": 1},
    "project_id": {"type": ["string", "null"]},
    "text": {"type": "string", "minLength": 1},
    "classification": {"enum": ["official_rule", "factual_observation", "opinion", "experience", "hypothesis", "recommendation"], "type": "string"},
    "region": {"type": ["string", "null"]},
    "validity": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "conflict_ids": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["proposed", "reviewed"], "type": "string"},
    "reviewer_ref": {"type": ["string", "null"]},
    "extensions": {"type": "object"}
  }
}
