{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/learning-review.schema.json",
  "title": "docops learning review",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "proposal_id",
    "proposal_hash",
    "decision",
    "actor",
    "role",
    "evidence_check",
    "publication_allowed",
    "derived",
    "state",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "proposal_hash": {"type": "string", "minLength": 64},
    "decision": {"enum": ["admit", "reject", "revoke"]},
    "actor": {"type": "string", "minLength": 1},
    "role": {"const": "human_approver"},
    "evidence_check": {
      "type": "object",
      "required": ["independent", "response_excluded", "references"],
      "properties": {
        "independent": {"type": "boolean"},
        "response_excluded": {"type": "boolean"},
        "references": {"type": "array"}
      }
    },
    "publication_allowed": {"const": false},
    "derived": {"type": "array"},
    "state": {"enum": ["admitted", "rejected", "revoked", "quarantined"]},
    "reviewed_at": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "rollback_blocked": {"type": "boolean"}
  }
}
