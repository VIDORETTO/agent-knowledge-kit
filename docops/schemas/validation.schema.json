{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta-documentacao.invalid/schemas/validation.schema.json",
  "title": "docops package validation result",
  "type": "object",
  "required": ["schema_version", "ok", "errors", "warnings", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "checks": {"type": "object"}
  }
}
